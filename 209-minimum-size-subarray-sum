class Solution(object):
    def minSubArrayLen(self, target, nums):
        l=0
        sum=0
        res=float('inf')
        for r in range(len(nums)):
            sum+=nums[r]
            while sum>=target:
                res=min(res,r-l+1)
                sum-=nums[l]
                l+=1
        if res==float('inf'):
            return 0
        return res
