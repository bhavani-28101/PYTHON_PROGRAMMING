class Solution:
    def findMissingAndRepeatedValues(self, grid):
        n = len(grid)
        total_numbers = n * n
        
        seen = set()
        repeated = -1
        actual_sum = 0
        
        for row in grid:
            for num in row:
                if num in seen:
                    repeated = num
                seen.add(num)
                actual_sum += num
        
        expected_sum = total_numbers * (total_numbers + 1) // 2
        
        missing = expected_sum - (actual_sum - repeated)
        
        return [repeated, missing]
