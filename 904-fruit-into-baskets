class Solution(object):
    def totalFruit(self, fruits):
        l,count,maxcount=0,0,0
        dict={}
        for r in range(len(fruits)):
            dict[fruits[r]]=dict.get(fruits[r],0)+1
            count+=1
            while(len(dict)>2):
                dict[fruits[l]]-=1
                count-=1
                if(dict[fruits[l]]==0):
                    dict.pop(fruits[l])
                l+=1
            maxcount=max(count,maxcount)
        return maxcount
