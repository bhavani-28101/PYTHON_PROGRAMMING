class Solution(object):
    def isValid(self, s):
        dict={"}":"{","]":"[",")":"("}
        stack=[]
        for ch in s:
            if(ch in "({["):
                stack.append(ch)
            else:
                if stack and stack[-1]==dict[ch]:
                    stack.pop()
                else:
                    return False
        return len(stack)==0
