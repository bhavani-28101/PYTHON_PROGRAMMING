class Solution(object):
    def applyOperations(self, nums):
        k=0
        for i in range(1,len(nums)):
            if(nums[i]==nums[i-1]):
                nums[i-1]=nums[i-1]*2
                nums[i]=0
        for r in range(len(nums)):
            if(nums[r]!=0):
                nums[k],nums[r]=nums[r],nums[k]
                k+=1
        return nums
