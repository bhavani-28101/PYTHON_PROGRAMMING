class Solution(object):
    def rearrangeString(self, s, x, y):
        arr=list(s)
        l,r=0,len(s)-1
        while(l<r):
            if(arr[l]==x and arr[r]==y):
                temp=arr[l]
                arr[l]=arr[r]
                arr[r]=temp
                l+=1
                r-=1
            while(l<r and arr[l]!=x):
                l+=1
            while(l<r and arr[r]!=y):
                r-=1
        return ''.join(arr)
        
