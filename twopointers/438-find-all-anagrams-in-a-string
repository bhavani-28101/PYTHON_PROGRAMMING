class Solution:
    def findAnagrams(self, s: str, p: str) -> List[int]:
        if(len(s)<len(p)):
            return []
        res=[]
        p=sorted(p)
        l=0
        r=len(p)-1
        while(l<=r and r<len(s)):
            if(sorted(s[l:r+1])==p):
                res.append(l)
                l+=1
                r+=1
            else:
                l+=1
                r+=1
        return res
