class Solution(object):
    def merge(self, nums):
        nums.sort()
        temp1=nums[0][0]
        temp2=nums[0][1]
        mainres=[]
        for i in range(1,len(nums)):
            if(nums[i][0]<=temp2):
                temp2=max(temp2,nums[i][1])
            else:
                mainres.append([temp1,temp2])
                temp1=nums[i][0]
                temp2=nums[i][1]
        mainres.append([temp1,temp2])
        return mainres
