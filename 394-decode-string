class Solution(object):
    def decodeString(self, s):
        num=0
        cs=""
        stack=[]
        for ch in s:
            if(ch.isdigit()):
                num=num*10+int(ch)
            elif(ch=="["):
                stack.append([num,cs])
                num=0
                cs=""
            elif(ch=="]"):
                k,prev = stack.pop()
                cs=prev+k*cs
            else:
                cs+=ch
        return cs
        
