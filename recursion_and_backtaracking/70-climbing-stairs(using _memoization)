class Solution(object):
    def climbStairs(self, n):
        memo={}
        def steps(n):
            if(n==1):
                return 1
            if(n==2):
                return 2
            if n in memo:
                return memo[n]
            memo[n]=steps(n-1)+steps(n-2)
            return memo[n]
        return steps(n)
        
