class Solution(object):
    def subsetsWithDup(self, nums):
        res=[]
        subset=[]
        index=0
        nums=sorted(nums)
        self.backtrack(nums,res,subset,index)
        return res
    def backtrack(self,nums,res,subset,index):
        res.append(subset[:])
        if(index==len(nums)):
            return
        subset.append(nums[index])
        self.backtrack(nums,res,subset,index+1)
        subset.pop()
        
        next_i=index+1
        while(next_i<len(nums) and nums[next_i]==nums[index]):
            next_i+=1
        self.backtrack(nums,res,subset,index+1)
