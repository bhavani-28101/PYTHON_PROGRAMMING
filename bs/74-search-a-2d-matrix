class Solution(object):
    def searchMatrix(self, matrix, target):
        left,right=0,len(matrix)-1
        n=len(matrix[0])
        while(left<=right):
            mid=left+(right-left)//2
            if(matrix[mid][0]<=target and target <=matrix[mid][n-1]):
                for i in range(n):
                    if(matrix[mid][i]==target):
                        return True
                return False
            if(matrix[mid][0]>target):
                right=mid-1
            else:
                left=mid+1
        return False
