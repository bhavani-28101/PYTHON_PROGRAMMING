class Solution(object):
    def insert(self, nums1, nums2):
        mainres=[]
        if(len(nums1)==0):
            return [nums2]
        if(len(nums2)==0):
            return nums1
        def binarysearch(nums1,nums2,l,h):
            if(l>h):
                return l
            mid=l+(h-l)//2
            temp1=nums2[0]
            temp2=nums2[1]
            if(nums1[mid][0]>temp1):
                return binarysearch(nums1,nums2,l,mid-1)
            elif(nums1[mid][0]<temp1):
                return binarysearch(nums1,nums2,mid+1,h)
            else:
                return mid
        mid=binarysearch(nums1,nums2,0,len(nums1)-1)
        nums1.insert(mid,nums2)
        temp1=nums1[0][0]
        temp2=nums1[0][1]
        for i in range(1,len(nums1)):
            if(nums1[i][0]<=temp2):
                temp2=max(temp2,nums1[i][1])
            else:
                mainres.append([temp1,temp2])
                temp1=nums1[i][0]
                temp2=nums1[i][1]
        mainres.append([temp1,temp2])
        return mainres
            
            
        
