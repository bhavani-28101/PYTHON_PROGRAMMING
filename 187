class Solution(object):
    def findRepeatedDnaSequences(self, s):
        l=0
        res=[]
        seq=0
        mainres=[]
        dict={'A':0,'C':0,'G':0,'T':0}
        for r in range(len(s)):
            dict[s[r]]=dict.get(s[r],0)+1
            while(r-l+1>10):
                dict[s[l]]-=1
                l+=1
            if(r-l+1==10 and s[l:r+1] in res):
                mainres.append(s[l:r+1])
            if(r-l+1==10):
                res.append(s[l:r+1])
        return mainres
